# ============================================
# Railway Environment Variables
# ============================================
# Copia estas variáveis para o Railway Dashboard
# (Variables tab de cada serviço)
#
# PostgreSQL e Redis são add-ons do Railway —
# as variáveis DATABASE_URL e REDIS_URL são
# geradas automaticamente.
#
# ORDEM DE DEPLOY:
#   1º PostgreSQL + Redis (add-ons)
#   2º Evolution API (precisa da BD)
#   3º PHP Laravel (corre migrations)
#   4º Python (precisa do PHP + Evolution prontos)
#
# EVOLUTION API — VOLUME PERSISTENTE:
#   Dashboard → Serviço Evolution API → Settings
#   → Volumes → Add Volume → mount em /evolution/instances
#   Sem isto a sessão WhatsApp desliga a cada restart.
# ============================================

# ---- PHP/Laravel Service ----

APP_NAME="WhatsApp Marketplace"
APP_ENV=production
APP_KEY=base64:/La+s5QSjJjOHSGdy7SkH4EZnWirsbJlUt76dGigv/U=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

# PostgreSQL (gerado pelo Railway add-on)
# DB_CONNECTION=pgsql
# DB_HOST=postgres.railway.internal
# DB_PORT=5432
# DB_DATABASE=railway
# DB_USERNAME=postgres
# DB_PASSWORD= (via DATABASE_URL)

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Redis (gerado pelo Railway add-on)
# REDIS_HOST=redis.railway.internal
# REDIS_PORT=6379
# REDIS_PASSWORD= (via REDIS_URL)

# Python service (link entre serviços)
PYTHON_SERVICE_URL=http://python.railway.internal:5000

# Evolution API
EVOLUTION_API_URL=https://evolution-api.up.railway.app
EVOLUTION_API_KEY=chave_aqui

# ---- Python Service ----

PHP_API_URL=http://php.railway.internal:8000/api/mensagem
EVOLUTION_API_URL=https://evolution-api.up.railway.app
EVOLUTION_API_KEY=chave_aqui

# ---- Evolution API Service (se deploy no Railway) ----

SERVER_URL=https://evolution-api.up.railway.app
AUTHENTICATION_API_KEY=chave_aqui
DATABASE_ENABLED=true
# DATABASE_CONNECTION_URI=via Railway link com PostgreSQL
