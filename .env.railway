# ============================================
# Railway Environment Variables
# ============================================
# Copia estas variáveis para o Railway Dashboard
# (Variables tab de cada serviço)
#
# PostgreSQL e Redis são add-ons do Railway —
# as variáveis DATABASE_URL e REDIS_URL são
# geradas automaticamente.
#
# ORDEM DE DEPLOY:
#   1º PostgreSQL + Redis (add-ons)
#   2º WAHA (precisa da BD)
#   3º PHP Laravel (corre migrations)
#   4º Python (precisa do PHP + WAHA prontos)
#
# WAHA — VOLUME PERSISTENTE:
#   Dashboard → Serviço WAHA → Settings
#   → Volumes → Add Volume → mount em /app/.media
#   Sem isto a sessão WhatsApp desliga a cada restart.
#
# IMPORTANTE: NÃO commite secrets reais neste ficheiro.
# Use placeholders e configure os valores reais no Railway Dashboard.
# ============================================

# ---- PHP/Laravel Service ----

APP_NAME="WhatsApp Marketplace"
APP_ENV=production
APP_KEY=CHANGE_ME_GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

# PostgreSQL (gerado pelo Railway add-on)
# DB_CONNECTION=pgsql
# DB_HOST=postgres.railway.internal
# DB_PORT=5432
# DB_DATABASE=railway
# DB_USERNAME=postgres
# DB_PASSWORD= (via DATABASE_URL)

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Redis (gerado pelo Railway add-on)
# REDIS_HOST=redis.railway.internal
# REDIS_PORT=6379
# REDIS_PASSWORD= (via REDIS_URL)

# Python service (link entre serviços)
PYTHON_SERVICE_URL=http://python.railway.internal:5000

# WAHA (4 lojas)
WAHA_URL_1=https://waha-1.up.railway.app
WAHA_URL_2=https://waha-2.up.railway.app
WAHA_URL_3=https://waha-3.up.railway.app
WAHA_URL_4=https://waha-4.up.railway.app
WAHA_API_KEY=CHANGE_ME_RANDOM_SECRET

# ---- Python Service ----

PHP_API_URL=http://php.railway.internal:8000/api/mensagem
WAHA_API_KEY=CHANGE_ME_RANDOM_SECRET
WAHA_URL_1=https://waha-1.up.railway.app
WAHA_URL_2=https://waha-2.up.railway.app
WAHA_URL_3=https://waha-3.up.railway.app
WAHA_URL_4=https://waha-4.up.railway.app
TENANT_ID_DEFAULT=1

# ---- WAHA Service (se deploy no Railway) ----

WAHA_CORE_LOG_LEVEL=info
